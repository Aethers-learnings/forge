#!/usr/bin/env python3
"""Entry point for deterministic Forge autonomous task operations."""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from agent_runtime.runtime import ForgeRuntime, next_safe_task, run_autopilot


def main() -> int:
    parser = argparse.ArgumentParser(description="Forge autonomous engineering controller")
    parser.add_argument("command", choices=("status", "next", "run", "auto"))
    parser.add_argument("task_id", nargs="?")
    parser.add_argument("--max-tasks", type=int, default=3)
    args = parser.parse_args()
    if args.command == "auto":
        if args.max_tasks < 1:
            parser.error("--max-tasks must be at least 1")
        print(json.dumps(run_autopilot(ROOT, args.max_tasks), indent=2))
        return 0
    runtime = ForgeRuntime(ROOT)
    if args.command == "status":
        print(json.dumps(runtime.status(), indent=2, default=str))
        return 0
    task = next_safe_task(runtime.tasks()) if args.command == "next" else next((item for item in runtime.tasks() if item.id == args.task_id), None)
    if task is None:
        print("No dependency-satisfied SAFE_INCREMENTAL task available", file=sys.stderr)
        return 1
    if args.command == "next":
        print(task.id)
        return 0
    try:
        runtime.safety_gate(task)
    except PermissionError as exc:
        print(str(exc), file=sys.stderr)
        return 2
    try:
        print(json.dumps(runtime.run_task(task), indent=2))
        return 0
    except (RuntimeError, ValueError, PermissionError) as exc:
        print(str(exc), file=sys.stderr)
        return 3


if __name__ == "__main__":
    raise SystemExit(main())
