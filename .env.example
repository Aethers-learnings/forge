# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# Runtime mode. Production must use FORGE_ENV=production.
FORGE_ENV=development

# Both are disabled by default. They may only be enabled for local development.
FORGE_DEBUG=0
FORGE_DEMO_MODE=0

FORGE_SECRET_KEY=change-me-to-something-random

# Optional — enables the real AI career coach. Without it, a rule-based
# fallback is used and the demo still works.
ANTHROPIC_API_KEY=

# Optional — enables real outbound email (sign-in alerts, password resets).
# Without these, emails are logged to the server console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
